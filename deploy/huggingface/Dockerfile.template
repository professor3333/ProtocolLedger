# Hugging Face Space (Docker SDK) for the public ProtocolLedger demo.
# Generated by scripts/publish_demo.py: the code commit and model revision are pinned.
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
COPY --from=ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
RUN git clone --quiet https://github.com/professor3333/ProtocolLedger.git /app \
    && git -C /app checkout --quiet __COMMIT__
WORKDIR /app
RUN uv sync --locked --no-dev --no-editable --extra serve-neural
RUN /app/.venv/bin/python -c "from huggingface_hub import snapshot_download; \
snapshot_download('__MODEL_REPO__', revision='__MODEL_REVISION__', local_dir='/models/__MODEL_VERSION__')"
RUN useradd --create-home --uid 1000 user && rm -rf /models/__MODEL_VERSION__/.cache
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PROTOCOLLEDGER_BUNDLE=/models/__MODEL_VERSION__ \
    PROTOCOLLEDGER_DB=/tmp/reviews.db \
    PROTOCOLLEDGER_THREADS=2 \
    PROTOCOLLEDGER_PUBLIC_DEMO=1
USER user
EXPOSE 7860
CMD ["uvicorn", "--factory", "protocolledger.serve.app:create_app_from_env", "--host", "0.0.0.0", "--port", "7860"]
